function out_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}function ss_(){return SpreadsheetApp.openById(SPREADSHEET_ID);}function sh_(n){return ss_().getSheetByName(n);}function nowIso_(){return new Date().toISOString();}
function ensureSchema_(){const s=sh_(USERS_SHEET);if(!s)throw new Error("USERS sheet not found");if(String(s.getRange(3,15).getValue()||"")!=="hash_version")s.getRange(3,15).setValue("hash_version");[PRODUCTS_SHEET,PROPOSALS_SHEET,QUOTATIONS_SHEET].forEach(n=>{if(!sh_(n))throw new Error(n+" sheet not found");});}
function ensurePepper_(){const p=PropertiesService.getScriptProperties();let x=p.getProperty("PEFSO_AUTH_PEPPER");if(!x){x=Utilities.getUuid()+Utilities.getUuid()+Utilities.getUuid();p.setProperty("PEFSO_AUTH_PEPPER",x);}return x;}function hex_(b){return b.map(x=>{let v=(x<0?x+256:x).toString(16);return v.length===1?"0"+v:v;}).join("");}function sha256_(t){return hex_(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,t,Utilities.Charset.UTF_8));}function hashV1_(pin,salt){return sha256_(String(salt)+":"+String(pin));}function hashV2_(pin,salt){return sha256_(ensurePepper_()+":"+String(salt)+":"+String(pin));}function randomSalt_(){return Utilities.getUuid().replace(/-/g,"")+Utilities.getUuid().replace(/-/g,"");}function randomToken_(){return sha256_(Utilities.getUuid()+":"+Utilities.getUuid()+":"+Date.now());}function validPin_(p){return /^\d{8}$/.test(String(p||""));}
function rowsAsObjects_(sheet,headerRow){const lr=sheet.getLastRow(),lc=sheet.getLastColumn();if(lr<headerRow)return {headers:[],rows:[]};const v=sheet.getRange(headerRow,1,lr-headerRow+1,lc).getValues(),h=v[0].map(String);return {headers:h,rows:v.slice(1).map((r,i)=>{let o={_row:headerRow+1+i};h.forEach((k,j)=>{if(k)o[k]=r[j];});return o;}).filter(o=>h.some(k=>String(o[k]??"").trim()!==""))};}
