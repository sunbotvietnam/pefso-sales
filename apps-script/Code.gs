function nextQuotationNo_(){const y=Utilities.formatDate(new Date(),"Asia/Bangkok","yyyy"),rows=rowsAsObjects_(sh_(QUOTATIONS_SHEET),3).rows;let n=1;rows.forEach(r=>{let m=String(r.quotation_no||"").match(/^QT-(\d{4})-(\d+)$/);if(m&&m[1]===y)n=Math.max(n,Number(m[2])+1)});return "QT-"+y+"-"+String(n).padStart(4,"0");}
function saveQuotation_(p){const u=requireUser_(p);if(!String(p.buyer_company||"").trim())throw new Error("Buyer company required");if(!String(p.item_code||"").trim())throw new Error("Item code required");const qno=nextQuotationNo_(),id=qno+"-V1",qty=Number(p.quantity||0),req=Number(p.requested_unit_price||0),approved=(u.role==="admin"?Number(p.approved_unit_price||0):0),status=approved>0?"Approved":"Pending Approval",price=approved||req,total=price*qty;sh_(QUOTATIONS_SHEET).appendRow([id,qno,1,new Date(),u.user_id,p.buyer_company||"",p.buyer_contact||"",p.buyer_email||"",p.country||"",p.item_code||"",p.color||"",qty,req,approved||"",p.currency||"USD",p.incoterm||"FOB Vietnam",p.destination_port||"",p.payment_terms||"",Number(p.validity_days||15),p.lead_time||"",total||"",status,approved>0?u.user_id:"",approved>0?new Date():""]);audit_(u.user_id,"SAVE_QUOTATION",id,"success",status);return {ok:true,quotation_id:id,quotation_no:qno,version:1,status,total_value:total};}
