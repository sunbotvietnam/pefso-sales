function saveProposal_(p){const u=requireUser_(p);if(!String(p.buyer_company||"").trim())throw new Error("Buyer company required");const id="PR-"+Utilities.formatDate(new Date(),"Asia/Bangkok","yyyyMMdd-HHmmss")+"-"+String(Math.floor(Math.random()*900)+100);sh_(PROPOSALS_SHEET).appendRow([id,new Date(),u.user_id,p.buyer_company||"",p.buyer_contact||"",p.buyer_email||"",p.country||"",p.selected_item_codes||"",p.buyer_context||"",p.recommended_direction||"",p.customization||"",p.next_step||"","Draft",p.html_snapshot||"",p.notes||""]);audit_(u.user_id,"SAVE_PROPOSAL",id,"success",p.buyer_company||"");return {ok:true,proposal_id:id,status:"Draft"};}
