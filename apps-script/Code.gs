function login_(p){const id=String(p.user_id||"").trim(),pin=String(p.pin||"");if(!id||!validPin_(pin))return {ok:false,error:"ID hoặc PIN không hợp lệ"};const u=findUser_(id);if(!u||String(u.active).toLowerCase()!=="true"){logAttempt_(id,false,"user_not_found_or_inactive");return {ok:false,error:"ID hoặc PIN không đúng"};}const ver=String(u.hash_version||"v1_sha256_salt"),cand=ver==="v2_pepper_sha256"?hashV2_(pin,u.salt):hashV1_(pin,u.salt);if(cand!==String(u.pin_hash)){logAttempt_(id,false,"bad_pin");return {ok:false,error:"ID hoặc PIN không đúng"};}if(ver!=="v2_pepper_sha256"){const salt=randomSalt_();updateUserHash_(u._row,pin,salt);u.salt=salt;u.hash_version="v2_pepper_sha256";}const token=randomToken_(),issued=new Date(),expires=new Date(issued.getTime()+8*60*60*1000);sh_(SESSIONS_SHEET).appendRow([sha256_(token),u.user_id,u.role,issued,expires,issued,true,"","","login"]);logAttempt_(id,true,"");audit_(u.user_id,"LOGIN",u.user_id,"success","");return {ok:true,token,user:safeUser_(u)};}
function updateUserHash_(row,pin,salt){const s=sh_(USERS_SHEET);s.getRange(row,4).setValue(hashV2_(pin,salt));s.getRange(row,5).setValue(salt);s.getRange(row,13).setValue(nowIso_());s.getRange(row,15).setValue("v2_pepper_sha256");}
function sessionUser_(token){if(!token)return null;const h=sha256_(String(token)),s=sh_(SESSIONS_SHEET),d=s.getDataRange().getValues();if(d.length<4)return null;const heads=d[2].map(String);for(let i=3;i<d.length;i++){let o={};heads.forEach((k,j)=>{if(k)o[k]=d[i][j]});if(String(o.session_token_hash)===h&&String(o.active).toLowerCase()==="true"&&new Date(o.expires_at).getTime()>Date.now()){const u=findUser_(o.user_id);if(!u||String(u.active).toLowerCase()!=="true")return null;s.getRange(i+1,6).setValue(new Date());return u;}}return null;}function requireUser_(p){const u=sessionUser_(p.token);if(!u)throw new Error("Unauthorized");return u;}function requireAdmin_(p){const u=requireUser_(p);if(String(u.can_manage_users).toLowerCase()!=="true")throw new Error("Forbidden");return u;}function safeUser_(u){return {user_id:u.user_id,role:u.role,display_name:u.display_name,active:u.active,permissions:{can_manage_users:u.can_manage_users,can_manage_products:u.can_manage_products,can_approve_quotation:u.can_approve_quotation,can_see_all_customers:u.can_see_all_customers,can_manage_prices:u.can_manage_prices}};}function me_(p){return {ok:true,user:safeUser_(requireUser_(p))};}
function logout_(p){if(!p.token)return {ok:true};const h=sha256_(String(p.token)),s=sh_(SESSIONS_SHEET),d=s.getDataRange().getValues();for(let i=3;i<d.length;i++){if(String(d[i][0])===h){s.getRange(i+1,7).setValue(false);break;}}return {ok:true};}
function listUsers_(p){requireAdmin_(p);return {ok:true,users:rowsAsObjects_(sh_(USERS_SHEET),3).rows.map(safeUser_)}}function roleDefaults_(r){if(r==="admin")return {can_manage_users:true,can_manage_products:true,can_approve_quotation:true,can_see_all_customers:true,can_manage_prices:true};if(r==="staff")return {can_manage_users:false,can_manage_products:true,can_approve_quotation:false,can_see_all_customers:true,can_manage_prices:false};return {can_manage_users:false,can_manage_products:false,can_approve_quotation:false,can_see_all_customers:false,can_manage_prices:false};}
function saveUser_(p){const actor=requireAdmin_(p),old=String(p.original_user_id||"").trim(),id=String(p.user_id||"").trim(),role=String(p.role||"").trim(),name=String(p.display_name||"").trim();if(!/^[A-Za-z0-9._-]{3,40}$/.test(id))throw new Error("User ID format invalid");if(!["admin","staff","collaborator"].includes(role))throw new Error("Role invalid");const s=sh_(USERS_SHEET),same=old?findUser_(old):null,clash=findUser_(id);if(clash&&(!same||clash._row!==same._row))throw new Error("User ID already exists");const f=roleDefaults_(role);if(same){s.getRange(same._row,1,1,3).setValues([[id,role,name||id]]);s.getRange(same._row,6,1,6).setValues([[p.active!==false,f.can_manage_users,f.can_manage_products,f.can_approve_quotation,f.can_see_all_customers,f.can_manage_prices]]);s.getRange(same._row,13).setValue(nowIso_());audit_(actor.user_id,"UPDATE_USER",id,"success","");}else{if(!validPin_(p.pin))throw new Error("New user requires an 8-digit PIN");const salt=randomSalt_();s.appendRow([id,role,name||id,hashV2_(p.pin,salt),salt,true,f.can_manage_users,f.can_manage_products,f.can_approve_quotation,f.can_see_all_customers,f.can_manage_prices,nowIso_(),nowIso_(),"Created by "+actor.user_id,"v2_pepper_sha256"]);audit_(actor.user_id,"CREATE_USER",id,"success","");}return {ok:true};}
function resetPin_(p){const a=requireAdmin_(p),u=findUser_(p.user_id);if(!u)throw new Error("User not found");if(!validPin_(p.new_pin))throw new Error("PIN must contain exactly 8 digits");updateUserHash_(u._row,p.new_pin,randomSalt_());invalidateUserSessions_(u.user_id);audit_(a.user_id,"RESET_PIN",u.user_id,"success","");return {ok:true};}function changeOwnCredentials_(p){const u=requireUser_(p),oldPin=String(p.current_pin||""),newId=String(p.new_user_id||u.user_id).trim(),newPin=String(p.new_pin||"");if(!validPin_(oldPin))throw new Error("Current PIN required");const live=findUser_(u.user_id),ver=String(live.hash_version||"v1_sha256_salt"),check=ver==="v2_pepper_sha256"?hashV2_(oldPin,live.salt):hashV1_(oldPin,live.salt);if(check!==String(live.pin_hash))throw new Error("Current PIN incorrect");if(newId!==String(live.user_id)){if(findUser_(newId))throw new Error("New user ID already exists");if(!/^[A-Za-z0-9._-]{3,40}$/.test(newId))throw new Error("User ID format invalid");sh_(USERS_SHEET).getRange(live._row,1).setValue(newId);}if(newPin){if(!validPin_(newPin))throw new Error("New PIN must contain exactly 8 digits");updateUserHash_(live._row,newPin,randomSalt_());}else sh_(USERS_SHEET).getRange(live._row,13).setValue(nowIso_());invalidateUserSessions_(u.user_id);audit_(u.user_id,"CHANGE_OWN_CREDENTIALS",newId,"success","");return {ok:true,relogin:true,new_user_id:newId};}
function setUserActive_(p){const a=requireAdmin_(p),u=findUser_(p.user_id);if(!u)throw new Error("User not found");if(String(u.user_id)===String(a.user_id)&&p.active===false)throw new Error("Admin cannot deactivate current account");sh_(USERS_SHEET).getRange(u._row,6).setValue(!!p.active);sh_(USERS_SHEET).getRange(u._row,13).setValue(nowIso_());if(!p.active)invalidateUserSessions_(u.user_id);audit_(a.user_id,p.active?"ACTIVATE_USER":"DEACTIVATE_USER",u.user_id,"success","");return {ok:true};}function invalidateUserSessions_(id){const s=sh_(SESSIONS_SHEET),d=s.getDataRange().getValues();for(let i=3;i<d.length;i++)if(String(d[i][1])===String(id)&&String(d[i][6]).toLowerCase()==="true")s.getRange(i+1,7).setValue(false);}
